{
  "name": "akashx",
  "version": "0.1.0",
  "private": true,
  "description": "A TypeScript CLI built with oclif",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.0.0"
  },
  "bin": {
    "akashx": "bin/run.js"
  },
  "files": [
    "bin/run.js",
    "dist"
  ],
  "scripts": {
    "dev": "node --import tsx bin/dev.js",
    "build": "tsc",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepack": "npm run build"
  },
  "oclif": {
    "bin": "akashx",
    "dirname": "akashx",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "topics": {
      "config": {
        "description": "Configure tenant networks and wallet selection"
      },
      "wallet": {
        "description": "Create, import, inspect and fund wallet accounts"
      },
      "fund": {
        "description": "Prepare native deployment funding"
      },
      "cert": {
        "description": "Manage tenant client certificates"
      },
      "deployment": {
        "description": "Create, run, inspect and close tenant workloads"
      },
      "lease": {
        "description": "Inspect leases and accept provider bids"
      },
      "provider": {
        "description": "Inspect registered providers"
      },
      "bridge": {
        "description": "Quote, send and track cross-chain transfers"
      }
    }
  },
  "dependencies": {
    "@akashnetwork/chain-sdk": "1.0.0-alpha.45",
    "@cosmjs/crypto": "^0.38.1",
    "@cosmjs/encoding": "^0.38.1",
    "@cosmjs/proto-signing": "~0.38.0",
    "@oclif/core": "^5.1.2",
    "@skip-go/client": "^1.6.6",
    "chalk": "^6.0.1",
    "protobufjs": "^8.8.0",
    "viem": "^2.57.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@types/ws": "^8.18.2",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
